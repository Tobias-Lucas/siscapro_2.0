# Copie para .env.development ou execute npm run dev:setup para gerar segredos aleatorios.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
JWT_EXPIRES_IN=8h
JWT_SECRET=GERAR_SEGREDO_ALEATORIO_COM_PELO_MENOS_48_CARACTERES
POSTGRES_DB=proativa_dev
POSTGRES_USER=proativa_dev
POSTGRES_PASSWORD=GERAR_SENHA_ALEATORIA
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql://proativa_dev:GERAR_SENHA_ALEATORIA@localhost:5433/proativa_dev?schema=public
REDIS_URL=redis://localhost:6380
AITINET_ADMIN_EMAIL=admin@proativa.local
AITINET_ADMIN_NAME=Administrador do Sistema
AITINET_ADMIN_PASSWORD=GERAR_SENHA_FORTE_COM_PELO_MENOS_14_CARACTERES
DOCUMENTS_DIR=./.local-documents
LEGACY_ENABLED=false
LEGACY_ENABLE_ACCOUNT_LOGIN=false
DEMO_SEED_ENABLED=false

# Apenas desenvolvimento local: execute scripts/prepare-private-import.ps1 para preencher.
# IMPORT_DB_PASSWORD= (segredo local gerado automaticamente)
# IMPORT_DB_PORT=3310

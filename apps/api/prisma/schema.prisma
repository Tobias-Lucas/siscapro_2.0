generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SECRETARY
  FINANCE
  TRIAGE
  CONTRACTS
  SOCIAL_SERVICE
  RECEPTION
  COMMERCIAL
  HR
  STUDENT
  PROFESSOR
  COMPANY
  INTERNSHIP_SUPERVISOR
  APPRENTICE
  CANDIDATE
  LEGAL_GUARDIAN
}

enum PasswordAlgorithm {
  ARGON2ID
  LEGACY_MD5
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  PENDING
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  SUSPENDED
  TERMINATED
  CANCELLED
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
  CANCELLED
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  login             String?           @unique
  passwordHash      String
  passwordAlgorithm PasswordAlgorithm @default(ARGON2ID)
  role              UserRole          @default(RECEPTION)
  active            Boolean           @default(false)
  legacySource      String?
  legacyId          String?
  legacyRoleRaw     String?
  legacyDepartmentRaw String?
  disciplines     Discipline[]
  disciplineTeachers DisciplineTeacher[]
  personId          String?
  companyId         String?
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  person            Person?           @relation(fields: [personId], references: [id])
  company           Company?          @relation(fields: [companyId], references: [id])
  auditLogs         AuditLog[]
  teacherAssignments TeacherAssignment[]

  @@index([legacySource, legacyId])
  userUnitEntries UserUnit[]
  academicLessonEntries AcademicLesson[]
  contractMovementEntries ContractMovement[]
  internshipSupervisorEntries InternshipSupervisor[]
  serviceInteractionEntries ServiceInteraction[]
  socialVisitEntries SocialVisit[]
  portalMessageEntries PortalMessage[]
  documentReviewEntries DocumentReview[]
  teacherAvailabilityEntries TeacherAvailability[]
  scheduleRules ScheduleRule[]
  scheduleTemplateEntries ScheduleTemplate[]
  scheduleGenerationRunEntries ScheduleGenerationRun[]
  resolvedScheduleConflictEntries ScheduleConflict[]
  accessMode String @default("LEGACY")
  accessTemplateId String?
  accessTemplateVersion Int?
  accessTemplate AccessTemplate? @relation(fields: [accessTemplateId], references: [id], onDelete: SetNull)
  accessOverrides AccessOverride[]
  createdDemandEntries Demand[] @relation("DemandCreator")
  assignedDemandEntries Demand[] @relation("DemandAssignee")
  createdDemandTaskEntries DemandTask[] @relation("DemandTaskCreator")
  assignedDemandTaskEntries DemandTask[] @relation("DemandTaskAssignee")
}

model Person {
  id              String       @id @default(cuid())
  fullName        String
  socialName      String?
  cpf             String?      @unique
  rg              String?
  birthDate       DateTime?
  sex             String?
  email           String?
  phone           String?
  secondaryPhone  String?
  zipCode         String?
  address         String?
  addressNumber   String?
  addressExtra    String?
  district        String?
  city            String?
  state           String?
  motherName      String?
  fatherName      String?
  legalGuardian   String?
  guardianCpf     String?
  guardianEmail   String?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  users           User[]
  enrollments     Enrollment[]
  contracts       Contract[]
  applications    Application[]
  attendances     Attendance[]
  grades           Grade[]
  serviceRequests ServiceRequest[]
  documents       Document[]
  materialReleaseEntries MaterialRelease[]
  absenceJustificationEntries AbsenceJustification[]
  socialVisitEntries SocialVisit[]
  selectionEntryEntries SelectionEntry[]
  demandTaskEntries DemandTask[]
}

model Company {
  id              String       @id @default(cuid())
  cnpj            String?      @unique
  legalName       String
  tradeName       String?
  email           String?
  financeEmail    String?
  phone           String?
  zipCode         String?
  address         String?
  addressNumber   String?
  district        String?
  city            String?
  state           String?
  legalRep        String?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  users           User[]
  contracts       Contract[]
  vacancies       Vacancy[]
  financialTitles FinancialTitle[]
  enrollments     Enrollment[]
  companyGroupMemberEntries CompanyGroupMember[]
  companyContactEntries CompanyContact[]
  businessContractEntries BusinessContract[]
  internshipSupervisorEntries InternshipSupervisor[]
  invoiceEntries Invoice[]
  socialVisitEntries SocialVisit[]
  demandEntries Demand[]
}

model Course {
  id          String       @id @default(cuid())
  name        String
  code        String?
  modality    String?
  workload    Int?
  theoryWorkloadRaw String?
  practiceWorkloadRaw String?
  authorizationProtocol String?
  legacySegmentCode String?
  legacyUnitCode String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classGroups ClassGroup[]
  enrollments Enrollment[]
  contracts   Contract[]
  disciplines Discipline[]
  courseHours CourseHours[]
  teachingDays CourseTeachingDays[]
  disciplineTeachers DisciplineTeacher[]
  curriculumMatrixEntries CurriculumMatrix[]
  learningMaterialEntries LearningMaterial[]
  classGroupLinks ClassGroupCourse[]
}

model ClassGroup {
  id          String       @id @default(cuid())
  name        String
  code        String?
  type        String?
  courseId    String?
  unit        String?
  legacySegmentCode String?
  legacyProfileCode String?
  room        String?
  classroomId String?
  startDate   DateTime?
  endDate     DateTime?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course?      @relation(fields: [courseId], references: [id])
  enrollments Enrollment[]
  attendances Attendance[]
  grades      Grade[]
  teacherAssignments TeacherAssignment[]
  academicLessonEntries AcademicLesson[]
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  scheduleRuleEntries ScheduleRule[]
  courseLinks ClassGroupCourse[]
}

// Reproduces the existing academic structures and adds the normalized foundation for future timetable planning.
// `disciplinas` can be shared across courses (disc_id_curso may be null).
model Discipline {
  id             String        @id @default(cuid())
  courseId       String?
  teacherId      String?
  legacyProfessorReference String?
  name           String
  phaseCode      String?
  moduleLabel    String?
  workloadRaw    String?
  startDate      DateTime?
  endDate        DateTime?
  statusRaw      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  course         Course?       @relation(fields: [courseId], references: [id])
  teacher        User?         @relation(fields: [teacherId], references: [id])
  assignments    DisciplineTeacher[]

  @@index([courseId, phaseCode])
  curriculumModuleEntries CurriculumModule[]
  academicLessonEntries AcademicLesson[]
  learningMaterialEntries LearningMaterial[]
  scheduleRuleEntries ScheduleRule[]
}

// Source: disciplinas_vinculos_prof (teacher + course + discipline).
model DisciplineTeacher {
  id             String     @id @default(cuid())
  courseId       String
  disciplineId   String
  teacherId      String
  course         Course     @relation(fields: [courseId], references: [id])
  discipline     Discipline @relation(fields: [disciplineId], references: [id])
  teacher        User       @relation(fields: [teacherId], references: [id])
  createdAt      DateTime   @default(now())

  @@unique([courseId, disciplineId, teacherId])
  @@index([teacherId])
}

// Source: curso_horarios (registered course hours, not a generated weekly calendar).
model CourseHours {
  id            String   @id @default(cuid())
  courseId      String
  startTime     String
  endTime       String
  shift         String
  daysComboRaw  String?
  courseComboRaw String?
  startTime2    String?
  endTime2      String?
  shift2        String?
  daysCombo2Raw String?
  courseCombo2Raw String?
  unitRaw       String?
  course        Course   @relation(fields: [courseId], references: [id])
  teachingDays  CourseTeachingDays[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId])
}

// Source: curso_dias_aulas (weekdays and theory/practice part).
model CourseTeachingDays {
  id           String      @id @default(cuid())
  courseId     String
  hoursId      String
  monday       Boolean     @default(false)
  tuesday      Boolean     @default(false)
  wednesday    Boolean     @default(false)
  thursday     Boolean     @default(false)
  friday       Boolean     @default(false)
  saturday     Boolean     @default(false)
  partCode     String?
  unitRaw      String?
  course       Course      @relation(fields: [courseId], references: [id])
  hours        CourseHours @relation(fields: [hoursId], references: [id])

  @@index([courseId])
}

model TeacherAssignment {
  id           String   @id @default(cuid())
  userId       String
  classGroupId String
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  @@unique([userId, classGroupId])
  @@index([classGroupId])
}

model Enrollment {
  id          String       @id @default(cuid())
  personId    String
  courseId    String?
  classGroupId String?
  companyId   String?
  contractId  String?
  legacyContractReference String?
  rosterStartDate DateTime?
  rosterEndDate DateTime?
  returnDay   String?
  startDate   DateTime?
  endDate     DateTime?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  person      Person       @relation(fields: [personId], references: [id])
  course      Course?      @relation(fields: [courseId], references: [id])
  classGroup  ClassGroup?  @relation(fields: [classGroupId], references: [id])
  company     Company?     @relation(fields: [companyId], references: [id])
  contract    Contract?    @relation(fields: [contractId], references: [id])

  @@index([personId, classGroupId])
}

model Attendance {
  id           String   @id @default(cuid())
  personId     String
  classGroupId String
  classDate    DateTime
  sessionKey   String   @default("turn")
  legacyCode   String?
  legacyDateReference String?
  present      Boolean  @default(false)
  justified    Boolean  @default(false)
  reason       String?
  attachment   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  person       Person   @relation(fields: [personId], references: [id])
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  @@unique([personId, classGroupId, classDate, sessionKey])
  absenceJustificationEntries AbsenceJustification[]
}

model Grade {
  id           String   @id @default(cuid())
  personId     String
  classGroupId String
  label        String
  value        Decimal  @db.Decimal(10,2)
  maxValue     Decimal? @db.Decimal(10,2)
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  person       Person   @relation(fields: [personId], references: [id])
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
}

model Contract {
  id                String         @id @default(cuid())
  number            String?
  personId          String
  companyId         String?
  courseId          String?
  type              String?
  status            ContractStatus @default(DRAFT)
  startDate         DateTime?
  endDate           DateTime?
  suspensionStart   DateTime?
  suspensionEnd     DateTime?
  terminationDate   DateTime?
  monthlyValue      Decimal?       @db.Decimal(12,2)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  person            Person         @relation(fields: [personId], references: [id])
  company           Company?       @relation(fields: [companyId], references: [id])
  course            Course?        @relation(fields: [courseId], references: [id])
  enrollments       Enrollment[]
  internships       Internship[]
  financialTitles   FinancialTitle[]
  documents         Document[]
  contractAmendmentEntries ContractAmendment[]
  contractMovementEntries ContractMovement[]
}

model Internship {
  id             String       @id @default(cuid())
  contractId     String
  institution    String?
  supervisorName String?
  supervisorEmail String?
  courseName     String?
  semester       String?
  weeklyHours    Int?
  startTime      String?
  endTime        String?
  insurancePolicy String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contract       Contract     @relation(fields: [contractId], references: [id])
  internshipReportEntries InternshipReport[]
  internshipLeaveEntries InternshipLeave[]
}

model Vacancy {
  id             String       @id @default(cuid())
  companyId      String
  title          String
  profile        String?
  area           String?
  activities     String?
  city           String?
  district       String?
  minAge         Int?
  maxAge         Int?
  quantity       Int          @default(1)
  scholarship    Decimal?     @db.Decimal(12,2)
  expiresAt      DateTime?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company      @relation(fields: [companyId], references: [id])
  applications   Application[]
}

model Application {
  id         String        @id @default(cuid())
  vacancyId  String
  personId   String
  status     RequestStatus @default(OPEN)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  vacancy    Vacancy       @relation(fields: [vacancyId], references: [id])
  person     Person        @relation(fields: [personId], references: [id])

  @@unique([vacancyId, personId])
}

model FinancialTitle {
  id          String        @id @default(cuid())
  companyId   String?
  contractId  String?
  description String
  competence  String?
  dueDate     DateTime
  amount      Decimal       @db.Decimal(12,2)
  status      RequestStatus @default(OPEN)
  bankRef     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company?      @relation(fields: [companyId], references: [id])
  contract    Contract?     @relation(fields: [contractId], references: [id])
  payments    Payment[]
  billingAttachmentEntries BillingAttachment[]
}

model Payment {
  id               String   @id @default(cuid())
  financialTitleId String
  paidAt           DateTime
  amount           Decimal  @db.Decimal(12,2)
  externalRef      String?
  createdAt        DateTime @default(now())
  financialTitle   FinancialTitle @relation(fields: [financialTitleId], references: [id])

  @@unique([financialTitleId, externalRef])
}

model ServiceRequest {
  id          String        @id @default(cuid())
  personId    String?
  type        String
  description String?
  response    String?
  dueDate     DateTime?
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  person      Person?       @relation(fields: [personId], references: [id])
  serviceInteractionEntries ServiceInteraction[]
}

model Document {
  id          String       @id @default(cuid())
  personId    String?
  contractId  String?
  type        String
  fileName    String
  storageKey  String
  mimeType    String?
  checksum    String?
  version     Int          @default(1)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  person      Person?      @relation(fields: [personId], references: [id])
  contract    Contract?    @relation(fields: [contractId], references: [id])
  learningMaterialEntries LearningMaterial[]
  absenceJustificationEntries AbsenceJustification[]
  contractAmendmentEntries ContractAmendment[]
  billingAttachmentEntries BillingAttachment[]
  documentReviewEntries DocumentReview[]
}


// Operational demand workflow. Exact legacy column mapping remains a separate, evidence-based adapter.
model DemandType {
  id String @id @default(cuid())
  code String @unique
  name String
  active Boolean @default(true)
  legacyId String? @unique
  demands Demand[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Demand {
  id String @id @default(cuid())
  legacyId String? @unique
  legacyStatusRaw String?
  originChannel String @default("MANUAL")
  externalReference String?
  title String?
  description String?
  status String @default("OPEN")
  receivedAt DateTime?
  dueAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancellationReason String?
  companyId String?
  typeId String?
  unitId String?
  departmentId String?
  assignedUserId String?
  createdById String?
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  type DemandType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedUser User? @relation("DemandAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy User? @relation("DemandCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks DemandTask[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, receivedAt])
  @@unique([originChannel, externalReference])
  @@index([companyId, status])
  @@index([assignedUserId, status])
  @@index([unitId, departmentId])
}

model DemandTask {
  id String @id @default(cuid())
  legacyId String? @unique
  legacyStatusRaw String?
  demandId String
  personId String?
  assignedUserId String?
  createdById String?
  title String?
  description String?
  dueAt DateTime?
  status String @default("OPEN")
  completedAt DateTime?
  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  assignedUser User? @relation("DemandTaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy User? @relation("DemandTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([demandId, status])
  @@index([assignedUserId, status])
  @@index([personId])
}

model LegacyMapping {
  id         String   @id @default(cuid())
  source     String
  entity     String
  legacyId   String
  newId      String
  fingerprint String?
  syncedAt   DateTime @default(now())

  @@unique([source, entity, legacyId])
  @@index([entity, newId])
}

model SyncRun {
  id          String   @id @default(cuid())
  source      String
  entity      String?
  mode        String
  status      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  readCount   Int      @default(0)
  writeCount  Int      @default(0)
  errorCount  Int      @default(0)
  message     String?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}


model Unit {
  id String @id @default(cuid())
  code String @unique
  name String
  city String?
  state String?
  address String?
  status RecordStatus @default(ACTIVE)
  userUnitEntries UserUnit[]
  holidayEntries Holiday[]
  classroomEntries Classroom[]
  scheduleTemplateEntries ScheduleTemplate[]
  demandEntries Demand[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Department {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  status RecordStatus @default(ACTIVE)
  userUnitEntries UserUnit[]
  demandEntries Demand[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model UserUnit {
  id String @id @default(cuid())
  userId String
  unitId String
  departmentId String?
  active Boolean @default(true)
  user User @relation(fields: [userId], references: [id])
  unit Unit @relation(fields: [unitId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, unitId])
  @@index([userId])
  @@index([unitId])
  @@index([departmentId])
}


model ReferenceItem {
  id String @id @default(cuid())
  domain String
  code String
  label String
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([domain, code])
}


model CompanyGroup {
  id String @id @default(cuid())
  name String @unique
  description String?
  status RecordStatus @default(ACTIVE)
  companyGroupMemberEntries CompanyGroupMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model CompanyGroupMember {
  id String @id @default(cuid())
  groupId String
  companyId String
  group CompanyGroup @relation(fields: [groupId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([groupId, companyId])
  @@index([groupId])
  @@index([companyId])
}


model CompanyContact {
  id String @id @default(cuid())
  companyId String
  fullName String
  email String?
  phone String?
  category String
  position String?
  status RecordStatus @default(ACTIVE)
  company Company @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
}


model CurriculumMatrix {
  id String @id @default(cuid())
  courseId String
  code String
  version String
  title String
  durationMonths Int?
  totalWorkload Int?
  effectiveFrom DateTime?
  effectiveTo DateTime?
  status RecordStatus @default(ACTIVE)
  course Course @relation(fields: [courseId], references: [id])
  curriculumModuleEntries CurriculumModule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([courseId])
}


model CurriculumModule {
  id String @id @default(cuid())
  matrixId String
  disciplineId String?
  title String
  sequence Int
  plannedHours Int?
  lessonCount Int?
  mandatory Boolean @default(true)
  matrix CurriculumMatrix @relation(fields: [matrixId], references: [id])
  discipline Discipline? @relation(fields: [disciplineId], references: [id])
  scheduleRuleEntries ScheduleRule[]
  academicLessonEntries AcademicLesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([matrixId])
  @@index([disciplineId])
}


model AcademicLesson {
  id String @id @default(cuid())
  classGroupId String
  disciplineId String?
  teacherId String?
  title String
  lessonDate DateTime
  shift String
  room String?
  classroomId String?
  curriculumModuleId String?
  scheduleRuleId String?
  generationRunId String?
  state String @default("PLANNED")
  executedAt DateTime?
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id])
  discipline Discipline? @relation(fields: [disciplineId], references: [id])
  teacher User? @relation(fields: [teacherId], references: [id])
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  curriculumModule CurriculumModule? @relation(fields: [curriculumModuleId], references: [id])
  scheduleRule ScheduleRule? @relation(fields: [scheduleRuleId], references: [id])
  generationRun ScheduleGenerationRun? @relation(fields: [generationRunId], references: [id])
  scheduleConflicts ScheduleConflict[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([classGroupId])
  @@index([disciplineId])
  @@index([teacherId])
  @@index([classroomId, lessonDate])
  @@index([curriculumModuleId])
  @@index([scheduleRuleId])
  @@index([generationRunId])
}


// Physical room/learning environment. The legacy free-text room fields remain for compatibility.
model Classroom {
  id String @id @default(cuid())
  code String
  name String
  unitId String?
  floor String?
  capacity Int?
  roomType String?
  status RecordStatus @default(ACTIVE)
  notes String?
  unit Unit? @relation(fields: [unitId], references: [id])
  classGroupEntries ClassGroup[]
  academicLessonEntries AcademicLesson[]
  scheduleRuleEntries ScheduleRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([unitId, code])
  @@index([unitId])
  @@index([status])
}

// Facilitator availability by weekday, shift and time range; no automatic allocation is run in this version.
model TeacherAvailability {
  id String @id @default(cuid())
  teacherId String
  weekday Int // 1=segunda ... 7=domingo
  shift String
  startTime String
  endTime String
  availabilityType String @default("AVAILABLE")
  effectiveFrom DateTime?
  effectiveTo DateTime?
  notes String?
  teacher User @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([teacherId, weekday, shift])
  @@index([effectiveFrom, effectiveTo])
}

// A semester/period container for the manually reviewed weekly plan and its future generation runs.
model ScheduleTemplate {
  id String @id @default(cuid())
  name String
  periodStart DateTime
  periodEnd DateTime
  unitId String?

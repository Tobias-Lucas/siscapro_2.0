// Staging is strictly separate from operational tables. No credentials/PDF files are migrated.
model LegacyImportBatch {
  id String @id @default(cuid())
  source String @default("SISCAPRO_STAGING")
  status String @default("RUNNING")
  fileName String?
  fileBytes BigInt?
  fileHash String?
  stagingPhase String @default("RESTORE")
  importScope String @default("FULL")
  importControl String @default("RUN")
  importHeartbeat DateTime?
  importWorkerToken String?
  currentImportTable String?
  restoreTotalBytes BigInt?
  restoreProcessedBytes BigInt @default(0)
  restoreScannedBytes BigInt @default(0)
  completedImportChunks Int @default(0)
  tableSummaries LegacyImportTableStatus[]
  chunkCheckpoints LegacyImportChunkCheckpoint[]
  importEvents LegacyImportEvent[]
  recordResults LegacyImportRecordResult[]
  startedAt DateTime @default(now())
  finishedAt DateTime?
  rowCount Int @default(0)
  message String?
  rows LegacyRawRow[]
}

model LegacyRawRow {
  id String @id @default(cuid())
  sourceTable String
  sourceKey String
  identityMethod String
  rowData Json
  contentHash String
  batchId String
  importedAt DateTime @default(now())
  batch LegacyImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  @@unique([batchId, sourceTable, sourceKey])
  @@index([batchId, sourceTable])
}

model LegacyImportIssue {
  id String @id @default(cuid())
  ruleCode String
  sourceTable String
  sourceKey String
  targetTable String
  targetKey String?
  status String @default("OPEN")
  observation String?
  detectedAt DateTime @default(now())
  resolvedAt DateTime?
  @@unique([ruleCode, sourceTable, sourceKey])
  @@index([status, ruleCode])
}

// Resume-safe migration summaries; never store personal data or raw SQL in operational logs.
model LegacyImportTableStatus {
  id String @id @default(cuid())
  batchId String
  sourceTable String
  targetEntity String?
  recordCount Int @default(0)
  writtenCount Int @default(0)
  skippedCount Int @default(0)
  failedCount Int @default(0)
  status String @default("PENDING")
  reasonCode String?
  reason String?
  updatedAt DateTime @updatedAt
  batch LegacyImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  @@unique([batchId, sourceTable])
  @@index([batchId, status])
}

// Audit every attempted transformation by source key, destination and reason.
model LegacyImportRecordResult {
  id String @id @default(cuid())
  batchId String
  sourceTable String
  sourceKey String
  targetEntity String
  targetId String?
  status String
  reasonCode String?
  explanation String?
  processedAt DateTime @default(now())
  batch LegacyImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  @@unique([batchId, sourceTable, sourceKey])
  @@index([batchId, status])
}

// Additive, resumable checkpoints for RESTORE, STAGING and TRANSFORM.
// Only source table names, offsets and hashes; never SQL text or personal fields.
model LegacyImportChunkCheckpoint {
  id String @id @default(cuid())
  batchId String
  phase String
  sequence Int
  sourceTable String
  startOffset BigInt?
  endOffset BigInt?
  rowCount Int @default(0)
  statementCount Int @default(0)
  checksum String?
  cursor String?
  status String @default("COMPLETED")
  reasonCode String?
  createdAt DateTime @default(now())
  completedAt DateTime @default(now())
  batch LegacyImportBatch @relation(fields:[batchId], references:[id], onDelete:Cascade)
  @@unique([batchId,phase,sequence])
  @@index([batchId,phase,sourceTable,status], map: "LegacyImportChunk_batch_phase_table_status_idx")
}

// Eventos operacionais de importacao, sem conteudo pessoal ou texto SQL.
model LegacyImportEvent {
  id String @id @default(cuid())
  batchId String
  phase String
  level String @default("INFO")
  sourceTable String?
  message String
  createdAt DateTime @default(now())
  batch LegacyImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  @@index([batchId, createdAt])
}

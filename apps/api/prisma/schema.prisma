// V3: modular IAM - grants are explicit; CUSTOM accounts deny by default.
model AccessTemplate {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  active Boolean @default(true)
  version Int @default(1)
  grants AccessGrant[]
  revisions AccessTemplateRevision[]
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccessGrant {
  id String @id @default(cuid())
  templateId String
  code String
  scope String @default("GLOBAL")
  allowedFields Json?
  template AccessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  @@unique([templateId, code])
  @@index([code])
}


model AccessTemplateRevision {
  id String @id @default(cuid())
  templateId String
  version Int
  createdById String?
  changeNote String?
  createdAt DateTime @default(now())
  template AccessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  grants AccessTemplateRevisionGrant[]
  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model AccessTemplateRevisionGrant {
  id String @id @default(cuid())
  revisionId String
  code String
  scope String @default("GLOBAL")
  allowedFields Json?
  revision AccessTemplateRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  @@unique([revisionId, code])
  @@index([code])
}

model AccessOverride {
  id String @id @default(cuid())
  userId String
  code String
  allowed Boolean
  scope String @default("GLOBAL")
  allowedFields Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, code])
  @@index([code])
}


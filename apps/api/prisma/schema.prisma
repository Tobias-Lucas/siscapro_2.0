// Recurrence rule for a class/turma. weekPattern supports every week, alternating weeks and custom week numbers.
model ScheduleRule {
  id String @id @default(cuid())
  templateId String
  classGroupId String
  curriculumModuleId String?
  disciplineId String?
  teacherId String?
  classroomId String?
  weekday Int
  startTime String
  endTime String
  weekPattern String @default("EVERY_WEEK") // EVERY_WEEK, FIRST_AND_FIFTH, FIRST_THIRD_FIFTH, SECOND_AND_FOURTH, CUSTOM
  weekNumbers Json? // semanas específicas quando weekPattern=CUSTOM
  partCode String?
  activityLabel String?
  sequence Int @default(0)
  active Boolean @default(true)
  notes String?
  template ScheduleTemplate @relation(fields: [templateId], references: [id])
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id])
  curriculumModule CurriculumModule? @relation(fields: [curriculumModuleId], references: [id])
  discipline Discipline? @relation(fields: [disciplineId], references: [id])
  teacher User? @relation(fields: [teacherId], references: [id])
  classroom Classroom? @relation(fields: [classroomId], references: [id])
  academicLessons AcademicLesson[]
  conflicts ScheduleConflict[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([templateId, weekday, startTime])
  @@index([classGroupId])
  @@index([teacherId, weekday])
  @@index([classroomId, weekday])
  @@index([curriculumModuleId])
}

// Audit record for a future cronogram-generation operation. It is only a data structure in V2.2.
model ScheduleGenerationRun {

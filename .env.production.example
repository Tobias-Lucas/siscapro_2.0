# Modelo: copie para .env.production e substitua todos os valores de exemplo.
# Nunca inclua este arquivo preenchido em ZIP, Git, imagem Docker ou mensagem.
NODE_ENV=production
WEB_PORT=8080
WEB_ORIGIN=https://SEU-DOMINIO
COOKIE_SECURE=true
JWT_EXPIRES_IN=8h
JWT_SECRET=GERAR_SEGREDO_ALEATORIO_FORTE_COM_PELO_MENOS_64_BYTES
POSTGRES_DB=proativa_prod
POSTGRES_USER=proativa_prod
POSTGRES_PASSWORD=GERAR_SENHA_ALEATORIA_FORTE
DATABASE_URL=postgresql://proativa_prod:GERAR_SENHA_ALEATORIA_FORTE@postgres:5432/proativa_prod?schema=public
REDIS_URL=redis://redis:6379
AITINET_ADMIN_EMAIL=admin@SEU-DOMINIO
AITINET_ADMIN_NAME=Administrador do Sistema
AITINET_ADMIN_PASSWORD=GERAR_SENHA_FORTE_COM_PELO_MENOS_14_CARACTERES
LEGACY_ENABLED=false
LEGACY_ENABLE_ACCOUNT_LOGIN=false
DEMO_SEED_ENABLED=false
PROATIVA_API_IMAGE=SEU_REGISTRY/proativa-api:3.2.0
PROATIVA_WEB_IMAGE=SEU_REGISTRY/proativa-web:3.2.0

# PROATIVA 2.0 V3.0.0 - Desenvolvimento local. NUNCA versionar .env
NODE_ENV=development
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
API_PORT=3000
POSTGRES_DB=proativa
POSTGRES_USER=proativa
POSTGRES_PASSWORD=change-me-now
DATABASE_URL=postgresql://proativa:change-me-now@postgres:5432/proativa?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-64-random-characters-before-production
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
AITINET_ADMIN_NAME=Aitinet
AITINET_ADMIN_EMAIL=admin@aitinet.local
AITINET_ADMIN_PASSWORD=ChangeThisNow!2026
# Contas ficticias desativadas. Habilitar somente em homologacao isolada, se necessario.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
DOCUMENTS_DIR=/app/private-documents
# Integração MariaDB: DESABILITADA por padrao. Nunca use credencial de escrita em producao.
LEGACY_ENABLED=false
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_SSL=false
LEGACY_SYNC_BATCH_SIZE=500
LEGACY_ROLE_MAP_JSON={}
LEGACY_ENABLE_ACCOUNT_LOGIN=false

# Carga de staging: EXECUTAR SOMENTE em base MariaDB anonimizada restaurada localmente.
STAGING_IMPORT_CONFIRM=
ADMIN_RESET_CONFIRM=
ADMIN_RESET_EMAIL=
ADMIN_RESET_PASSWORD=
